#include <stdio.h>
#define MAX 20
int main() {
    int n, m, i, j, k, found, choice;
    int alloc[MAX][MAX], request[MAX][MAX];
    int avail[MAX], work[MAX], finish[MAX] = {0};
    int sequence[MAX], count = 0;
printf("Enter number of processes: ");
scanf("%d", &n);

printf("Enter number of resource types: ");
scanf("%d", &m);

if (n < 1 || n > MAX || m < 1 || m > MAX) {
    printf("Invalid input!\n");
    return 1;
}

printf("Enter Allocation Matrix:\n");
for (i = 0; i < n; i++)
    for (j = 0; j < m; j++)
        scanf("%d", &alloc[i][j]);

printf("Enter Request Matrix:\n");
for (i = 0; i < n; i++)
    for (j = 0; j < m; j++)
        scanf("%d", &request[i][j]);

printf("Enter Available Resources:\n");
for (j = 0; j < m; j++)
    scanf("%d", &avail[j]);

for (j = 0; j < m; j++)
    work[j] = avail[j];

for (i = 0; i < n; i++) {
    finish[i] = 1;

    for (j = 0; j < m; j++) {
        if (alloc[i][j] != 0)
            finish[i] = 0;
    }
}

do {
    found = 0;

    for (i = 0; i < n; i++) {
        if (!finish[i]) {
            for (j = 0; j < m; j++) {
                if (request[i][j] > work[j])
                    break;
            }

            if (j == m) {
                for (k = 0; k < m; k++)
                    work[k] += alloc[i][k];

                finish[i] = 1;
                sequence[count++] = i;
                found = 1;
            }
        }
    }
} while (found);

printf("\n--- Deadlock Detection ---\n");

found = 0;

for (i = 0; i < n; i++) {
    if (!finish[i]) {
        printf("P%d is deadlocked.\n", i);
        found = 1;
    }
}

if (!found) {
    printf("No deadlock detected!\n");
    printf("Completion sequence: ");

    for (i = 0; i < count; i++)
        printf("P%d ", sequence[i]);

    printf("\n");
    return 0;
}

printf("\n--- Deadlock Recovery ---\n");

while (found) {
    printf("Deadlocked processes: ");

    for (i = 0; i < n; i++)
        if (!finish[i])
            printf("P%d ", i);

    printf("\nEnter process number to terminate: ");

    if (scanf("%d", &choice) != 1)
        return 1;

    if (choice < 0 || choice >= n || finish[choice]) {
        printf("Invalid process number!\n");
        continue;
    }

    printf("Terminating P%d...\n", choice);

    for (j = 0; j < m; j++)
        work[j] += alloc[choice][j];

    finish[choice] = 1;
    sequence[count++] = choice;

    do {
        found = 0;

        for (i = 0; i < n; i++) {
            if (!finish[i]) {
                for (j = 0; j < m; j++) {
                    if (request[i][j] > work[j])
                        break;
                }

                if (j == m) {
                    for (k = 0; k < m; k++)
                        work[k] += alloc[i][k];

                    finish[i] = 1;
                    sequence[count++] = i;
                    found = 1;

                    printf("P%d can now complete.\n", i);
                }
            }
        }
    } while (found);

    found = 0;

    for (i = 0; i < n; i++) {
        if (!finish[i]) {
            found = 1;
            break;
        }
    }
}

printf("\nDeadlock recovered successfully!\n");
printf("Completion sequence: ");

for (i = 0; i < count; i++)
    printf("P%d ", sequence[i]);

printf("\n");

return 0;
}
